# Copy to .env.local (gitignored) and fill in. Add the same vars in Vercel
# → Project → Settings → Environment Variables.

# --- Supabase -----------------------------------------------------------
# Supabase dashboard → Project Settings → API (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / publishable key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Connect → ORMs/Connection string → "Transaction pooler" (port 6543).
# Used by the app at runtime (serverless-friendly).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase → Connect → "Session pooler" (port 5432). Used by drizzle-kit for
# migrations. Not needed on Vercel.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- AI -----------------------------------------------------------------
# https://console.anthropic.com → API Keys. Powers /api/chat and the Ask flow.
# Optional for the demo: without it, Ask uses canned fallback responses.
ANTHROPIC_API_KEY=
# Model for the Ask flow's AI steps (src/lib/ai/ask/*). Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# https://platform.openai.com/api-keys. Only used for RAG embeddings;
# chat still works without it.
OPENAI_API_KEY=

# --- App ----------------------------------------------------------------
# Base URL for auth redirects. http://localhost:3000 locally; your Vercel
# production URL in Vercel. Must be listed in Supabase → Auth → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Group chat bot (optional; unset → posts are logged to the console) ---
# GroupMe: dev.groupme.com → Bots → Create Bot. Leave the callback URL empty
# (the bot is post-only and never reads the group).
GROUPME_BOT_ID=
# Slack: api.slack.com/apps → your app → Incoming Webhooks → Add New Webhook.
SLACK_WEBHOOK_URL=
